{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xq.example.invalid/schemas/upstream-lock.schema.json",
  "title": "Approved OpenClaw upstream lock",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "repository", "release", "installer", "checksumAsset", "sourceFiles", "approval"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["owner", "name", "repositoryId"],
      "properties": { "owner": { "const": "openclaw" }, "name": { "const": "openclaw" }, "repositoryId": { "const": 1103012935 } }
    },
    "release": {
      "type": "object", "additionalProperties": false, "required": ["tag", "releaseId", "draft", "prerelease", "publishedAtUtc"],
      "properties": { "tag": { "type": "string", "minLength": 1 }, "releaseId": { "type": "integer", "minimum": 1 }, "draft": { "const": false }, "prerelease": { "const": false }, "publishedAtUtc": { "type": "string", "format": "date-time" } }
    },
    "installer": {
      "type": "object", "additionalProperties": false, "required": ["assetId", "name", "size", "sha256", "signerSubject", "signerThumbprint", "timestampRequired"],
      "properties": { "assetId": { "type": "integer", "minimum": 1 }, "name": { "const": "OpenClawCompanion-Setup-x64.exe" }, "size": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "signerSubject": { "type": "string", "minLength": 1 }, "signerThumbprint": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" }, "timestampRequired": { "const": true } }
    },
    "checksumAsset": {
      "type": "object", "additionalProperties": false, "required": ["assetId", "name", "sha256"],
      "properties": { "assetId": { "type": "integer", "minimum": 1 }, "name": { "const": "OpenClawCompanion-SHA256SUMS.txt" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "sourceFiles": {
      "type": "object", "additionalProperties": false, "required": ["commitSha", "licenseSha256", "thirdPartyNoticesSha256"],
      "properties": { "commitSha": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" }, "licenseSha256": { "$ref": "#/$defs/sha256" }, "thirdPartyNoticesSha256": { "$ref": "#/$defs/sha256" } }
    },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["status", "approvedAtUtc", "approvedBy"],
      "properties": { "status": { "const": "approved" }, "approvedAtUtc": { "type": "string", "format": "date-time" }, "approvedBy": { "type": "string", "minLength": 1 } }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" } }
}
