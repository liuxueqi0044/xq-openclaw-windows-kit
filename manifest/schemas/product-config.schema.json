{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xq.example.invalid/schemas/product-config.schema.json",
  "title": "XQ product static configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productId", "productVersion", "supportedOs", "primaryInstallMode", "diagnosticReportVersion", "licenseNotice", "policyDefaults", "productBoundary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productId": { "const": "xq-openclaw-windows-kit" },
    "productVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "supportedOs": { "type": "array", "const": ["Windows 11 x64"] },
    "primaryInstallMode": { "const": "windows-hub-local-managed-wsl" },
    "diagnosticReportVersion": { "const": 1 },
    "licenseNotice": { "type": "string", "minLength": 1 },
    "policyDefaults": {
      "type": "object", "additionalProperties": false,
      "required": ["unknownState", "unknownOfficialPrerequisiteAction", "failClosed"],
      "properties": {
        "unknownState": { "const": "unverified" },
        "unknownOfficialPrerequisiteAction": { "const": "block-release" },
        "failClosed": { "const": true }
      }
    },
    "productBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["productName", "relationshipStatement", "included", "excluded", "customerDataAllowedForSupport", "customerDataNeverRequested"],
      "properties": {
        "productName": { "type": "string", "minLength": 1 },
        "relationshipStatement": { "type": "string", "minLength": 1 },
        "included": { "$ref": "#/$defs/nonEmptyStringArray" },
        "excluded": { "$ref": "#/$defs/nonEmptyStringArray" },
        "customerDataAllowedForSupport": { "$ref": "#/$defs/nonEmptyStringArray" },
        "customerDataNeverRequested": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
