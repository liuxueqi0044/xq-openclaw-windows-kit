{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xq.example.invalid/schemas/provenance.schema.json",
  "title": "Package source and version provenance",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "buildMode", "productVersion", "gitCommit", "builtAtUtc", "builderVersion", "upstream", "installer", "sourceFiles", "automatedTests"],
  "properties": {
    "schemaVersion": { "const": 1 }, "buildMode": { "enum": ["formal", "test-fixture-non-release"] }, "productVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, "gitCommit": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" }, "builtAtUtc": { "type": "string", "format": "date-time" }, "builderVersion": { "type": "string", "minLength": 1 },
    "upstream": { "type": "object", "additionalProperties": false, "required": ["repository", "tag", "releaseId"], "properties": { "repository": { "const": "openclaw/openclaw" }, "tag": { "type": "string", "minLength": 1 }, "releaseId": { "type": "integer", "minimum": 1 } } },
    "installer": { "type": "object", "additionalProperties": false, "required": ["assetId", "size", "sha256", "officialChecksumMatched", "authenticode"], "properties": { "assetId": { "type": "integer", "minimum": 1 }, "size": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "officialChecksumMatched": { "const": true }, "authenticode": { "type": "object", "additionalProperties": false, "required": ["status", "subject", "thumbprint", "timestampValid"], "properties": { "status": { "const": "Valid" }, "subject": { "type": "string", "minLength": 1 }, "thumbprint": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" }, "timestampValid": { "const": true } } } } },
    "sourceFiles": { "type": "object", "additionalProperties": false, "required": ["commitSha", "licenseSha256", "thirdPartyNoticesSha256"], "properties": { "commitSha": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" }, "licenseSha256": { "$ref": "#/$defs/sha256" }, "thirdPartyNoticesSha256": { "$ref": "#/$defs/sha256" } } },
    "automatedTests": { "type": "object", "additionalProperties": false, "required": ["passed", "summary", "totalCount", "skippedCount", "pesterVersion", "reportSha256", "coveragePercent", "coverageTarget", "coverageReportSha256", "analyzerPassed"], "properties": { "passed": { "const": true }, "summary": { "type": "string", "minLength": 1 }, "totalCount": { "type": "integer", "minimum": 1 }, "skippedCount": { "const": 0 }, "pesterVersion": { "const": "5.7.1" }, "reportSha256": { "$ref": "#/$defs/sha256" }, "coveragePercent": { "type": "number", "minimum": 85, "maximum": 100 }, "coverageTarget": { "const": 85 }, "coverageReportSha256": { "$ref": "#/$defs/sha256" }, "analyzerPassed": { "type": "boolean" } } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" } }
}
